# ── Required ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
# Signed uploads (recommended). Alternatively set CLOUDINARY_UPLOAD_PRESET.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=

# ── Required in production ──────────────────────────────────────────────────
# Exact browser origins allowed to call this API, comma separated.
# There is no wildcard default in production: unset means all browsers blocked.
FRONTEND_ORIGIN=http://localhost:3001

# Externally reachable URL of THIS service. Deployment URLs are built from it.
PUBLIC_BASE_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Deployment URLs default to <PUBLIC_BASE_URL>/<id>/ which works anywhere.
# Subdomain URLs need a custom domain with BOTH a wildcard DNS record and a
# wildcard TLS certificate -- *.onrender.com provides neither.
# DEPLOYMENT_DOMAIN=rwaft.example.com
# DEPLOYMENT_WILDCARD=true

# Per-hour caps, keyed by account (falling back to user id, then IP). Unset,
# they default to 3 prompts / 5 deploys in free mode and 20 / 20 with PROD=true,
# where credits are the real meter and the cap only stops bursts. Keep the
# prompt cap above SIGNUP_TOKENS or new users can't spend their free credits.
# DEPLOY_RATE_LIMIT=20
# PROMPT_RATE_LIMIT=20

# Repository hosts /deploy will clone from. Use * to allow any public host.
ALLOWED_REPO_HOSTS=github.com,gitlab.com,bitbucket.org

# MAX_PROMPT_CHARS=8000
# JSON_BODY_LIMIT=64kb
# STATUS_TTL_SECONDS=86400
# SSE_HEARTBEAT_MS=25000
# SSE_HISTORY_LIMIT=300
# STAGING_ROOT=/tmp/rwaft-staging
# TRUST_PROXY_HOPS=1

# ── Accounts and billing ────────────────────────────────────────────────────
# PROD=true meters builds: a Google account is required and each build costs
# tokens (refunded if it fails). PROD=false (default) keeps everything free and
# anonymous use working. Under docker compose, the shell's PROD wins over this.
PROD=false

# OAuth 2.0 Web client ID from Google Cloud Console → APIs & Services →
# Credentials. Add every frontend origin (e.g. http://localhost:3001 and your
# Vercel URL) under "Authorized JavaScript origins". Sign-in is hidden without it.
GOOGLE_CLIENT_ID=

# Credits: 1 per message (prompt build) and per repo deploy; 5 free on sign-up.
# DEPLOY_TOKEN_COST=1
# PROMPT_TOKEN_COST=1
# SIGNUP_TOKENS=5
# SESSION_TTL_SECONDS=2592000
# AUTH_RATE_LIMIT=30

# ── Push to GitHub ──────────────────────────────────────────────────────────
# A GitHub OAuth App (github.com/settings/developers → New OAuth App). Set its
# "Authorization callback URL" to <PUBLIC_BASE_URL>/github/callback, e.g.
# http://localhost:3000/github/callback. The button is hidden without both.
# Each push asks for access once and revokes the token as soon as it ends.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only if the callback must differ from <PUBLIC_BASE_URL>/github/callback.
# GITHUB_REDIRECT_URI=
# GITHUB_RATE_LIMIT=20

# Buying tokens (Stripe Checkout). Both are needed for the "Buy tokens" button.
# Webhook endpoint: <PUBLIC_BASE_URL>/billing/webhook, events
# checkout.session.completed and checkout.session.async_payment_succeeded.
# Locally: stripe listen --forward-to localhost:3000/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=usd
# Packs as id:tokens:price-in-minor-units, comma separated.
# TOKEN_PACKS=starter:50:500,builder:150:1200,studio:400:2800
