# ── Required ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Postgres: everything except the job queues (accounts, credits, sessions,
# deployments, saved source, build logs). Tables are created in DB_SCHEMA on
# first use. Never commit the real URL.
DATABASE_URL=postgres://rwaft:rwaft@localhost:5432/rwaft
# DB_SCHEMA=rwaft
# Managed Redis (e.g. Upstash) bills every command, PINGs and sweeps included.
# REDIS_PING_MS=240000     # PING on idle connections; 0 = never (TCP keepalive still runs)
# PR_TOKEN_SWEEP_MS=300000 # how often expired pull request tokens are revoked

CLOUDINARY_CLOUD_NAME=
# Signed uploads (recommended). Alternatively set CLOUDINARY_UPLOAD_PRESET.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=

# ── Required in production ──────────────────────────────────────────────────
# Exact browser origins allowed to call this API, comma separated.
# There is no wildcard default in production: unset means all browsers blocked.
FRONTEND_ORIGIN=http://localhost:3001

# Externally reachable URL of THIS service. Deployment URLs are built from it.
PUBLIC_BASE_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Deployment URLs default to <PUBLIC_BASE_URL>/<id>/ which works anywhere.
# Subdomain URLs need a custom domain with BOTH a wildcard DNS record and a
# wildcard TLS certificate -- *.onrender.com provides neither.
# DEPLOYMENT_DOMAIN=rwaft.example.com
# DEPLOYMENT_WILDCARD=true

# Per-hour caps, keyed by account (falling back to user id, then IP). Unset,
# they default to 3 prompts / 5 deploys in free mode and 20 / 20 with PROD=true,
# where credits are the real meter and the cap only stops bursts. Keep the
# prompt cap above SIGNUP_TOKENS or new users can't spend their free credits.
# DEPLOY_RATE_LIMIT=20
# PROMPT_RATE_LIMIT=20

# Every hosted page gets a small "Made with rwaft" corner link to the first
# FRONTEND_ORIGIN, tagged ?ref=badge. Set false to leave pages untouched.
# SITE_BADGE=true

# Repository hosts /deploy will clone from. Use * to allow any public host.
ALLOWED_REPO_HOSTS=github.com,gitlab.com,bitbucket.org

# MAX_PROMPT_CHARS=8000
# JSON_BODY_LIMIT=64kb
# STATUS_TTL_SECONDS=86400
# SSE_HEARTBEAT_MS=25000
# SSE_HISTORY_LIMIT=300
# STAGING_ROOT=/tmp/rwaft-staging
# TRUST_PROXY_HOPS=1

# ── Accounts and billing ────────────────────────────────────────────────────
# PROD=true meters builds: a Google account is required and each build costs
# tokens (refunded if it fails). PROD=false (default) keeps everything free and
# anonymous use working. Under docker compose, the shell's PROD wins over this.
PROD=false

# OAuth 2.0 Web client ID from Google Cloud Console → APIs & Services →
# Credentials. Add every frontend origin (e.g. http://localhost:3001 and your
# Vercel URL) under "Authorized JavaScript origins". Sign-in is hidden without it.
GOOGLE_CLIENT_ID=

# Credits: 1 per message (prompt build), per repo deploy and per pull request; 2 free on sign-up.
# DEPLOY_TOKEN_COST=1
# PROMPT_TOKEN_COST=1
# SIGNUP_TOKENS=2
# Once a week, an account below this many credits is topped back up to it
# (a floor, not a grant: bought credits above it are never touched). 0 = off.
# WEEKLY_CREDITS=5
# SESSION_TTL_SECONDS=2592000
# AUTH_RATE_LIMIT=30

# ── Push to GitHub ──────────────────────────────────────────────────────────
# A GitHub OAuth App (github.com/settings/developers → New OAuth App). Set its
# "Authorization callback URL" to <PUBLIC_BASE_URL>/github/callback, e.g.
# http://localhost:3000/github/callback. The button is hidden without both.
# Each push asks for access once and revokes the token as soon as it ends.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only if the callback must differ from <PUBLIC_BASE_URL>/github/callback.
# GITHUB_REDIRECT_URI=
# GITHUB_RATE_LIMIT=20

# ── Open a pull request ─────────────────────────────────────────────────────
# The console's "Pull request" tab uses the same OAuth App: the user names a
# repository and describes a change, approves access in a popup, and the
# worker writes the change through GitHub's API (no clone) and opens the PR
# from their account, on a fork when they can't push. The token is handed to
# the worker encrypted, then deleted and revoked when the job ends, so
# build-services needs the same GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET.
# PR_TOKEN_COST=1
# PR_RATE_LIMIT=20             # per hour; defaults to 3 with PROD=false
# PR_TOKEN_TTL_SECONDS=3600    # how long a token waits in line for its job
# Every token has a revoke deadline the worker keeps moving while it works
# (including while it watches a PR's checks). The API revokes any token left
# past its deadline once a minute, so a job that never ran or a worker that
# died can't leave GitHub access behind.
# Encryption key for that handover. Defaults to one derived from
# GITHUB_CLIENT_SECRET; if you set it, set the same value on build-services.
# GITHUB_TOKEN_KEY=

# Buying credits (Dodo Payments). In the Dodo dashboard:
#  1. Products → create one one-time product per pack, priced the same as the
#     pack's amount below (Dodo charges the product's price; this API only
#     displays the pack's amount).
#  2. Developer → API keys → create a key  → DODO_PAYMENTS_API_KEY.
#  3. Developer → Webhooks → add <PUBLIC_BASE_URL>/billing/webhook (this API's
#     origin, not the website's) with the payment.succeeded event, then copy
#     its signing secret (whsec_...) → DODO_PAYMENTS_WEBHOOK_KEY.
# All three of key, webhook secret and DODO_PRODUCTS enable "Buy credits".
# Keys, products and webhooks are separate in test and live mode: a key made
# in test mode needs test_mode, one made in live mode live_mode. At startup
# the API looks up each product and logs any key, mode or price mismatch.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Pack id → Dodo product id, comma separated. Packs without one are hidden.
# e.g. starter:pdt_abc123,builder:pdt_def456,studio:pdt_ghi789
DODO_PRODUCTS=
# Currency the pack prices are shown in; match your Dodo products.
# BILLING_CURRENCY=usd
# Packs as id:tokens:price-in-minor-units, comma separated.
# TOKEN_PACKS=starter:50:500,builder:150:1200,studio:400:2800

# ── Sign-up alerts ──────────────────────────────────────────────────────────
# Each new account is posted to the website's /api/signup-alert, which emails
# you through Gmail (the Gmail variables live in the frontend's env, not here).
# Use the same long random value on both sides, e.g. `openssl rand -hex 32`.
# Off unless set.
# SIGNUP_ALERT_SECRET=
# Defaults to <first FRONTEND_ORIGIN>/api/signup-alert.
# SIGNUP_ALERT_URL=

# ── Admin panel (<frontend>/admin) ──────────────────────────────────────────
# Password for the user and credits list. Defaults to the hardcoded RWAFTADMIN;
# set your own before sharing the site. Checked only on the API.
# ADMIN_PASSWORD=
