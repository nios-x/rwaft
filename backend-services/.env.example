# ── Required ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
# Signed uploads (recommended). Alternatively set CLOUDINARY_UPLOAD_PRESET.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=

# ── Required in production ──────────────────────────────────────────────────
# Exact browser origins allowed to call this API, comma separated.
# There is no wildcard default in production: unset means all browsers blocked.
FRONTEND_ORIGIN=http://localhost:3001

# Externally reachable URL of THIS service. Deployment URLs are built from it.
PUBLIC_BASE_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Deployment URLs default to <PUBLIC_BASE_URL>/<id>/ which works anywhere.
# Subdomain URLs need a custom domain with BOTH a wildcard DNS record and a
# wildcard TLS certificate -- *.onrender.com provides neither.
# DEPLOYMENT_DOMAIN=rwaft.example.com
# DEPLOYMENT_WILDCARD=true

# Per-hour caps, keyed by user id (falling back to IP).
DEPLOY_RATE_LIMIT=5
PROMPT_RATE_LIMIT=3

# Repository hosts /deploy will clone from. Use * to allow any public host.
ALLOWED_REPO_HOSTS=github.com,gitlab.com,bitbucket.org

# MAX_PROMPT_CHARS=8000
# JSON_BODY_LIMIT=64kb
# STATUS_TTL_SECONDS=86400
# SSE_HEARTBEAT_MS=25000
# SSE_HISTORY_LIMIT=300
# STAGING_ROOT=/tmp/rwaft-staging
# TRUST_PROXY_HOPS=1
