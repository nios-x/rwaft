# syntax=docker/dockerfile:1
#
# rwaft API — build from the repository root:
#   docker build -f Dockerfile.api -t rwaft-api .
#
# The API and the build worker are deliberately separate images. They have very
# different resource profiles (the API is idle and latency-sensitive; the worker
# pegs a CPU for minutes and needs disk) and must scale and restart
# independently. The previous single container ran both under a hand-written
# bash supervisor, so a crash in either killed the other and neither could be
# scaled on its own.

FROM oven/bun:1-debian

# git: simple-git clones submitted repositories.
# tini: reaps zombies and forwards SIGTERM so graceful shutdown actually runs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    tini \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app

COPY backend-services/package.json backend-services/bun.lock* ./backend-services/
WORKDIR /app/backend-services
# --frozen-lockfile keeps the image reproducible: a build can never silently
# resolve a different dependency tree than the one that was tested.
RUN bun install --frozen-lockfile

WORKDIR /app
COPY backend-services ./backend-services

# Drop privileges — the oven/bun images ship a non-root `bun` user.
RUN chown -R bun:bun /app
USER bun

ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD bun --eval "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /app/backend-services
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bun", "index.ts"]
