# Origin of the rwaft API. Inlined at build time, so it must be set in the
# Vercel project settings BEFORE the production build runs.
# There is no hardcoded production fallback -- a missing value fails visibly.
# Locally the API runs on :3000 and this console on :3001 (see package.json).
# Never run both on :3000: the console would end up calling itself.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Canonical public origin of this console, used for the canonical link,
# Open Graph URLs, the sitemap and robots.txt. Defaults to https://rwaft.live;
# self-hosted copies should set their own so they don't point search engines
# at rwaft.live.
# NEXT_PUBLIC_SITE_URL=https://rwaft.live

# X handle for privacy and support requests, shown in the footer and on
# /privacy and /terms. Defaults to soumya_7708.
# NEXT_PUBLIC_CONTACT_X=rwaft
# The public source repository, named in the site's structured data. Empty leaves it out.
# NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/nios-x/rwaft

# Sign-up alerts (app/api/signup-alert). The API posts each new account here
# and this emails it to you through Gmail. Server-only: never prefix these
# with NEXT_PUBLIC_. SIGNUP_ALERT_SECRET must equal the API's variable of the
# same name. GMAIL_APP_PASSWORD is an App Password
# (myaccount.google.com/apppasswords), not the account password.
# SIGNUP_ALERT_SECRET=
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=
# Where alerts go; defaults to GMAIL_USER.
# SIGNUP_ALERT_TO=

# Optional ownership tokens for Google Search Console and Bing Webmaster Tools
# (the content="" value of their HTML-tag method). A DNS TXT record works too.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
