# ── Required ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Postgres: everything except the job queues (accounts, credits, sessions,
# deployments, saved source, build logs). Tables are created in DB_SCHEMA on
# first use. Never commit the real URL.
DATABASE_URL=postgres://rwaft:rwaft@localhost:5432/rwaft
# DB_SCHEMA=rwaft
# Managed Redis (e.g. Upstash) bills every command, including the ones an idle
# worker sends just to wait. These keep an idle worker to a few thousand a day.
# QUEUE_BLOCK_SECONDS=60   # how long each job queue waits per BLMOVE
# CI_IDLE_MS=300000        # longest the check watcher sleeps with nothing due
# REDIS_PING_MS=240000     # PING on idle connections; 0 = never (TCP keepalive still runs)

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=

# ── Gemini (needed for the /prompt flow) ────────────────────────────────────
# At least one key is required. Numbered keys are tried in turn when one gets
# rate-limited, so you can spread load across several free-tier keys.
GEMINI_API_KEY=
# GEMINI_API_KEY1=
# ... up to GEMINI_API_KEY9

# Tried first; gemini-3.6-flash and gemini-3.5-flash are the fallbacks.
AI_MODEL=gemini-3.8-flash

# Optional second provider (any OpenAI-compatible API), tried after every
# Gemini model. A Gemini overload (503) hits every key at once; this is the
# only thing that gets a build through one. All three must be set.
# AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_MODEL=

# ── Generation pipeline ─────────────────────────────────────────────────────
# 1 plan call (pages + design schema) → foundation written by code → one call
# per page, in parallel → per-file syntax checks and repairs → usability check
# (lib/uxcheck.ts) → build. The design guidance each call carries lives in
# skills/*.md.
# PLAN_MAX_PAGES=5            # most pages a plan may have
# PAGE_CONCURRENCY=3          # pages written at the same time (mind free-tier rate limits)
# FILE_REPAIRS=2              # model fixes per broken file before the build step takes over
# UX_FIX_PASSES=1             # model fixes per page with usability findings; 0 only logs them
# AI_GENERATION_TIMEOUT_MS=180000

# Real photos (lib/photos.ts): pages describe each image, and with a key the
# worker swaps the random placeholder for a matching Pexels photo before the
# build (free key at https://www.pexels.com/api/; 200 searches an hour, cached
# 7 days). The site's footer then credits Pexels. Without it: placeholders.
# PEXELS_API_KEY=

# ── Follow-up changes and Push to GitHub ────────────────────────────────────
# A finished prompt build's source is kept in Redis (gzipped, without
# node_modules, dist or .env files), with its plan and request history, for
# this long. A follow-up message ("make the header darker") restores it,
# edits it and publishes a new version; "Push to GitHub" sends it to a repo.
# Each version keeps its own copy; all of them expire on their own.
# SOURCE_TTL_SECONDS=86400
# EDIT_MAX_SOURCE_CHARS=400000  # source sent with a change; the kit is trimmed first
# SOURCE_MAX_BYTES=2097152    # compressed; larger sources are not kept

# ── Pull requests ───────────────────────────────────────────────────────────
# The API's GitHub OAuth App values. The worker decrypts each pull request
# job's token with them and revokes it when the job ends; without them, PR
# jobs fail (and are refunded). Set GITHUB_TOKEN_KEY only if the API sets it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_TOKEN_KEY=
# Read budget: nothing is cloned, only the files the AI asks for are fetched.
# PR_MAX_READ_FILES=40
# PR_MAX_READ_CHARS=300000
# PR_MAX_FILE_BYTES=150000     # larger files are listed but never read
# PR_EXPLORE_ROUNDS=3          # rounds of "which files do you need?"
# PR_MAX_SEARCHES=5            # GitHub code searches per job (GitHub allows 10/min)
# PR_FOOTER_URL=https://rwaft.live
# "Fix failing checks": after a pull request opens, the worker follows its CI
# and pushes fixes for failing checks, keeping the token until it's done.
# CI_WATCH_WINDOW_MS=1800000   # how long to wait for checks on one commit
# CI_NO_CHECKS_MS=240000       # give up if no checks appear by then
# CI_MAX_FIXES=2               # fixes per pull request before handing back
# CI_POLL_MS=30000

# ── Timeouts ────────────────────────────────────────────────────────────────
# Installing and building a real React app takes minutes. The old single 60s
# timeout killed npm mid-download, leaving a half-extracted node_modules --
# the "tarball seems to be corrupted" / ENOENT failures.
INSTALL_TIMEOUT_MS=600000
BUILD_TIMEOUT_MS=600000
# Short leash for one-off commands the AI asks us to run.
COMMAND_TIMEOUT_MS=120000
# Hard ceiling for one complete job.
JOB_TIMEOUT_MS=900000

# ── Optional ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Scratch space for user builds. Keep this OFF the app directory.
BUILD_ROOT=/tmp/rwaft-builds
# Set only if the host requires an open port (e.g. a Render web service).
# PORT=

# TEMPLATE_REPO=https://github.com/nios-x/vite-template
# MAX_BUILD_REPAIRS=6
# LOG_HISTORY_LIMIT=500
# LOG_HISTORY_TTL_SECONDS=86400
