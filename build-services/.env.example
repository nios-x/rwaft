# ── Required ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=

# ── AI providers (needed for the /prompt flow) ──────────────────────────────
# At least one key is required. Numbered keys are tried in turn when a provider
# rate-limits, so you can spread load across several free-tier keys.
GEMINI_API_KEY=
# GEMINI_API_KEY1=
# ... up to GEMINI_API_KEY9

OPENROUTER_API_KEY=
# OPENROUTER_API_KEY1=
# ... up to OPENROUTER_API_KEY7

# AI_MODEL=gemini-3.7-flash
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ── Timeouts ────────────────────────────────────────────────────────────────
# Installing and building a real React app takes minutes. The old single 60s
# timeout killed npm mid-download, leaving a half-extracted node_modules --
# the "tarball seems to be corrupted" / ENOENT failures.
INSTALL_TIMEOUT_MS=600000
BUILD_TIMEOUT_MS=600000
# Short leash for one-off commands the AI asks us to run.
COMMAND_TIMEOUT_MS=120000
# Hard ceiling for one complete job.
JOB_TIMEOUT_MS=900000

# ── Optional ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Scratch space for user builds. Keep this OFF the app directory.
BUILD_ROOT=/tmp/rwaft-builds
# Set only if the host requires an open port (e.g. a Render web service).
# PORT=

# TEMPLATE_REPO=https://github.com/nios-x/vite-template
# MAX_BUILD_REPAIRS=6
# LOG_HISTORY_LIMIT=500
# LOG_HISTORY_TTL_SECONDS=86400
